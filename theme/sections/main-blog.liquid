<section class="ne-section">
  <div class="ne-shell">
    <h1 class="ne-display">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <ul class="ne-article-list">
        {%- for article in blog.articles -%}
          <li class="ne-article-list__item">
            <a class="ne-article-list__link" href="{{ article.url }}">
              <h2 class="ne-title">{{ article.title }}</h2>
              <p class="ne-caption ne-soft">{{ article.published_at | date: '%d.%m.%Y' }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endpaginate -%}
  </div>
</section>
{% stylesheet %}
  .ne-article-list { margin-top: var(--ne-space-xl); display: grid; gap: var(--ne-space-m); }
  .ne-article-list__item { padding-bottom: var(--ne-space-m); border-bottom: var(--ne-hairline) solid var(--ne-rule); }
  .ne-article-list__link { display: grid; gap: var(--ne-space-3xs); color: inherit; text-decoration: none; }
{% endstylesheet %}
{% schema %}
{ "name": "Blog", "tag": "section" }
{% endschema %}
