<footer class="ne-footer ne-section--tight">
  <hr class="ne-rule">
  <div class="ne-shell ne-footer__inner">
    <div class="ne-footer__brand">
      <span class="ne-footer__wordmark">{{ shop.name }}</span>
    </div>

    {%- assign menu = linklists[section.settings.menu] -%}
    {%- if menu.links.size > 0 -%}
      <nav class="ne-footer__nav" aria-label="{{ 'sections.footer.menu' | t }}">
        <ul class="ne-footer__list">
          {%- for link in menu.links -%}
            <li><a class="ne-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="ne-footer__legal ne-caption">
      {%- comment -%}
        Los textos legales son datos del propietario. No se inventan (§191): si no
        hay políticas publicadas, no se finge que existen.
      {%- endcomment -%}
      {%- if shop.policies.size > 0 -%}
        <ul class="ne-footer__policies">
          {%- for policy in shop.policies -%}
            <li><a class="ne-footer__link" href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .ne-footer__inner {
    display: grid;
    gap: var(--ne-space-l);
    padding-top: var(--ne-space-xl);
  }

  @media (min-width: 48em) {
    .ne-footer__inner {
      grid-template-columns: 1fr auto auto;
      align-items: start;
      gap: var(--ne-space-2xl);
    }
  }

  .ne-footer__wordmark {
    font-family: var(--ne-font-display);
    font-size: var(--ne-size-title);
    letter-spacing: var(--ne-tracking-title);
  }

  .ne-footer__list,
  .ne-footer__policies {
    display: grid;
    gap: var(--ne-space-2xs);
  }

  .ne-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--ne-touch-min);
    color: inherit;
    text-decoration: none;
    border-bottom: var(--ne-hairline) solid transparent;
  }
  .ne-footer__link:hover { border-bottom-color: var(--ne-accent); }

  .ne-footer__legal { display: grid; gap: var(--ne-space-s); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.footer.menu"
    }
  ]
}
{% endschema %}
