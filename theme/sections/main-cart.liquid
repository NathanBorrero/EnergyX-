{%- comment -%}
  Carrito.

  Es el carrito nativo de Shopify. No se recalcula ningún total en el cliente: la
  fuente de verdad comercial es Shopify y el frontend solo representa el estado
  (§209). El botón de checkout lleva al checkout real de Shopify.
{%- endcomment -%}

<ne-cart
  class="ne-section"
  data-ne-cart
  data-ne-section-id="{{ section.id }}"
>
<section aria-labelledby="ne-cart-title">
  <div class="ne-shell">
    <h1 class="ne-display" id="ne-cart-title">{{ 'cart.general.title' | t }}</h1>

    {%- comment -%}
      Lo que el script anuncia al actualizar. `role="status"`, así que un lector
      de pantalla lo lee sin robar el foco: el comprador se queda donde estaba.
    {%- endcomment -%}
    <p class="ne-visually-hidden" data-ne-cart-status role="status" aria-live="polite"></p>
    <p class="ne-notice ne-notice--alert" data-ne-cart-error hidden role="alert"></p>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="ne-cart__form">
        <ul class="ne-cart__list" data-ne-cart-lines>
          {%- for line in cart.items -%}
            <li class="ne-cart__line" data-ne-cart-line data-ne-line-key="{{ line.key }}">
              <a class="ne-cart__media" href="{{ line.url }}" tabindex="-1" aria-hidden="true">
                {% render 'ne-image',
                  image: line.image,
                  role: 'below_fold',
                  sizes: '96px',
                  widths: '96, 192',
                  max: 192,
                  ratio: '4 / 5',
                  alt: line.product.title
                %}
              </a>

              <div class="ne-cart__info">
                <a class="ne-cart__title" href="{{ line.url }}">{{ line.product.title }}</a>
                {%- unless line.variant.title contains 'Default' -%}
                  <p class="ne-caption ne-soft">{{ line.variant.title }}</p>
                {%- endunless -%}

                {%- comment -%}
                  Atribuciones de línea visibles al comprador. Las internas, que
                  empiezan por guion bajo, Shopify no las muestra; se filtran aquí
                  igualmente para no depender de ese comportamiento.
                {%- endcomment -%}
                {%- if line.properties.size > 0 -%}
                  <dl class="ne-cart__props ne-caption ne-soft">
                    {%- for prop in line.properties -%}
                      {%- unless prop.first == blank or prop.last == blank or prop.first contains '_ne_' -%}
                        <dt>{{ prop.first }}</dt><dd>{{ prop.last }}</dd>
                      {%- endunless -%}
                    {%- endfor -%}
                  </dl>
                {%- endif -%}
              </div>

              <div class="ne-cart__controls">
                {%- comment -%}
                  `forloop.index`, NO `line.index`: esa propiedad no existe en el
                  objeto `line_item`, y Liquid devuelve nil ante una propiedad
                  inexistente, así que `nil | plus: 1` daba 1 y TODAS las líneas
                  acababan con el mismo id. Etiquetas duplicadas: un lector de
                  pantalla anuncia la cantidad equivocada y pulsar la etiqueta de
                  la tercera línea enfoca la primera.
                {%- endcomment -%}
                <label class="ne-visually-hidden" for="ne-cart-qty-{{ section.id }}-{{ forloop.index }}">
                  {{ 'products.product.quantity' | t }} · {{ line.product.title }}
                </label>
                <input
                  class="ne-cart__qty"
                  id="ne-cart-qty-{{ section.id }}-{{ forloop.index }}"
                  type="number"
                  name="updates[]"
                  value="{{ line.quantity }}"
                  min="0"
                  step="1"
                  inputmode="numeric"
                  data-ne-line-qty
                >
                <p class="ne-cart__price">{{ line.final_line_price | money }}</p>
                {%- comment -%}
                  Enlace nativo de Shopify, que funciona sin JavaScript. El
                  script lo intercepta y manda una cantidad 0 por la API de
                  carrito: la misma operación, sin recargar.
                {%- endcomment -%}
                <a class="ne-button--text" href="{{ line.url_to_remove }}" data-ne-line-remove>
                  {{ 'cart.general.remove' | t }}
                  <span class="ne-visually-hidden">· {{ line.product.title }}</span>
                </a>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {% render 'ne-cod-coverage', section: section %}

        <footer class="ne-cart__foot">
          <button class="ne-button ne-button--quiet" type="submit" name="update">
            {{ 'cart.general.title' | t }}
          </button>

          <div class="ne-cart__totals">
            <p class="ne-cart__subtotal">
              <span class="ne-caption">{{ 'cart.general.subtotal' | t }}</span>
              <strong>{{ cart.total_price | money }}</strong>
            </p>
            <p class="ne-caption ne-soft">{{ 'cart.general.taxes_note' | t }}</p>
          </div>

          <button class="ne-button ne-button--accent" type="submit" name="checkout">
            {{ 'cart.general.checkout' | t }}
          </button>
        </footer>
      </form>
    {%- else -%}
      <p class="ne-lead">{{ 'cart.general.empty' | t }}</p>
      <p><a class="ne-button" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a></p>
    {%- endif -%}
  </div>
</section>
</ne-cart>

{%- comment -%}
  Los estilos de esta sección viven en `assets/ne-components.css`, con los de las
  demás piezas: el banco de pruebas en navegador carga ese mismo archivo, así que
  lo que la prueba verifica es el CSS real.
{%- endcomment -%}


{% schema %}
{ "name": "t:sections.main_cart.name", "tag": "section" }
{% endschema %}
