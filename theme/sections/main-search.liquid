<section class="ne-section">
  <div class="ne-shell">
    <h1 class="ne-display">{{ 'general.search.submit' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="ne-search__form">
      <label class="ne-visually-hidden" for="ne-search-input">{{ 'general.search.placeholder' | t }}</label>
      <input
        class="ne-search__input"
        id="ne-search-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
      >
      <button class="ne-button" type="submit">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        {%- paginate search.results by 24 -%}
          <ul class="ne-grid ne-product-grid" style="--ne-grid-cols: 3">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <li class="ne-product-grid__cell">
                  {% render 'ne-product-card', product: item, card_index: forloop.index0 %}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endpaginate -%}
      {%- else -%}
        <p class="ne-notice">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
  .ne-search__form { display: flex; gap: var(--ne-space-2xs); margin-block: var(--ne-space-l); }
  .ne-search__input {
    flex: 1;
    min-height: var(--ne-touch);
    padding: var(--ne-space-2xs) var(--ne-space-xs);
    border: var(--ne-hairline) solid var(--ne-border);
    background: var(--ne-paper);
  }
{% endstylesheet %}
{% schema %}
{ "name": "Búsqueda", "tag": "section" }
{% endschema %}
