<section class="ne-section">
  <div class="ne-shell">
    <h1 class="ne-display">{{ 'general.search.submit' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="ne-search__form">
      <label class="ne-visually-hidden" for="ne-search-input">{{ 'general.search.placeholder' | t }}</label>
      <input
        class="ne-search__input"
        id="ne-search-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
      >
      <button class="ne-button" type="submit">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        {%- paginate search.results by 24 -%}
          <ul class="ne-grid ne-product-grid" style="--ne-grid-cols: 3">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <li class="ne-product-grid__cell">
                  {% render 'ne-product-card', product: item, card_index: forloop.index0 %}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endpaginate -%}
      {%- else -%}
        <p class="ne-notice">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- comment -%}
  Los estilos de esta pieza viven en `assets/ne-components.css`.

  Razón única y verificable: la auditoría de accesibilidad y las pruebas en
  navegador cargan ESE archivo, así que lo que miden es el CSS real. Repartido
  por `{% stylesheet %}` de cada sección, cada banco de pruebas tendría que
  copiarlo, y una copia se desincroniza sin que nada lo diga. Ya pasó.
{%- endcomment -%}

{% schema %}
{ "name": "Búsqueda", "tag": "section" }
{% endschema %}
